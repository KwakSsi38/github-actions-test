# Google OAuth (required)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google token verification endpoint (default)
GOOGLE_TOKEN_INFO_BASE_URL=https://oauth2.googleapis.com

# Embedding server base URL
APP_EMBEDDING_BASE_URL=https://embedding-server-domain

# MCP recommendation candidate source (skill-search | mock)
APP_MCP_RECOMMENDATION_CANDIDATE_SOURCE=skill-search
# APP_MCP_RECOMMENDATION_WEIGHT_PRIMARY=0.60
# APP_MCP_RECOMMENDATION_WEIGHT_STARS=0.20
# APP_MCP_RECOMMENDATION_WEIGHT_FORKS=0.10
# APP_MCP_RECOMMENDATION_WEIGHT_FRESHNESS=0.10
# APP_MCP_RECOMMENDATION_FINAL_SCORE_THRESHOLD=0.45

# Optional: comma-separated admin emails promoted on Google login
ADMIN_ALLOWLIST_EMAILS=

# Optional JWT override values
# CUSTOM_JWT_SECRET_KEY=replace-with-strong-secret
# CUSTOM_JWT_ACCESS_EXPIRATION_SECONDS=1800
# CUSTOM_JWT_REFRESH_EXPIRATION_SECONDS=1209600
